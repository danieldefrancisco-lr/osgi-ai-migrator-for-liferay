<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.danieldefrancisco_lr</groupId>
        <artifactId>io.github.danieldefrancisco_lr.migrator.parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>io.github.danieldefrancisco_lr.migrator</artifactId>
    <packaging>eclipse-plugin</packaging>

    <properties>
        <core.jar>io.github.danieldefrancisco_lr.migrator.core.jar</core.jar>
    </properties>

    <!-- Declared so the reactor builds core first; the jar itself is embedded via Bundle-ClassPath -->
    <dependencies>
        <dependency>
            <groupId>io.github.danieldefrancisco_lr</groupId>
            <artifactId>io.github.danieldefrancisco_lr.migrator.core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Copy the core jar into lib/ before compiling, where MANIFEST.MF's Bundle-ClassPath expects it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>embed-core</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.github.danieldefrancisco_lr</groupId>
                                    <artifactId>io.github.danieldefrancisco_lr.migrator.core</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>${core.jar}</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.basedir}/lib</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>lib</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
